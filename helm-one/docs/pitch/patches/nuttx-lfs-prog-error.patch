diff --git a/fs/littlefs/lfs_prog_error.patch b/fs/littlefs/lfs_prog_error.patch
new file mode 100644
index 00000000000..9e19b9df795
--- /dev/null
+++ b/fs/littlefs/lfs_prog_error.patch
@@ -0,0 +1,33 @@
+fs/littlefs: report LFS_ERR_IO instead of asserting when pcache is dirty
+
+lfs_bd_flush() leaves the pcache holding the block that failed to program.
+A retried commit that lands on the other directory block then hits
+LFS_ASSERT(pcache->block == LFS_BLOCK_NULL), which aborts the calling
+thread.
+
+On this board the SD card returns -EIO wholesale while it is marked dead,
+so that window is reachable from ordinary logging (open() with O_CREAT
+triggers a metadata commit).  The transaction is lost either way; return
+an error and let the caller unwind instead of killing the thread.
+
+--- ./littlefs/littlefs/lfs.c
++++ ./littlefs/littlefs/lfs.c
+@@ -260,6 +260,17 @@
+         // pcache must have been flushed, either by programming and
+         // entire block or manually flushing the pcache
+-        LFS_ASSERT(pcache->block == LFS_BLOCK_NULL);
++        //
++        // Project deviation from upstream: report LFS_ERR_IO instead of
++        // asserting.  When the block device fails a program (our SD card
++        // returns -EIO wholesale while it is marked dead) lfs_bd_flush()
++        // leaves the pcache holding the failed block, and the retried
++        // commit may target the other directory block.  Aborting the
++        // calling thread turns one recoverable I/O error into a
++        // device-level failure; the transaction is lost either way, so
++        // let the caller unwind through its normal error path instead.
++        if (pcache->block != LFS_BLOCK_NULL) {
++            return LFS_ERR_IO;
++        }
+ 
+         // prepare pcache, first condition can no longer fail
+         pcache->block = block;
